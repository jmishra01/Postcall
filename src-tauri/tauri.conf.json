{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postcall",
  "version": "0.1.0",
  "identifier": "dev.postcall.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Postcall",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
